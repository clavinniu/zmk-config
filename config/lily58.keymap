#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <175>;
    require-prior-idle-ms = <175>;
};

&lt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <175>;
    require-prior-idle-ms = <175>;
};

/ {
    combos {
        compatible = "zmk,combos";

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <10 11>;
            layers = <0>;
        };

        expose {
            bindings = <&kp LC(UP_ARROW)>;
            key-positions = <53 54>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESC                            &kp N1            &kp N2              &kp N3                  &kp N4               &kp N5                                                  &kp N6                   &kp N7                      &kp N8                       &kp N9               &kp N0                &mt BACKSPACE EQUAL
&kp TAB                            &kp Q             &kp W               &kp E                   &kp R                &kp T                                                   &kp Y                    &kp U                       &kp I                        &kp O                &kp P                 &kp MINUS
&mt LA(LC(LS(LGUI))) SINGLE_QUOTE  &mt LEFT_SHIFT A  &mt LEFT_CONTROL S  &mt LEFT_ALT D          &mt LEFT_GUI F       &lt 3 G                                                 &lt 2 H                  &mt RIGHT_GUI J             &mt RIGHT_ALT K              &mt RIGHT_CONTROL L  &mt RIGHT_SHIFT SEMI  &mt RS(RA(RC(RIGHT_GUI))) RET
&kp LSHFT                          &kp Z             &kp X               &kp C                   &kp V                &kp B                       &lt 1 LBKT     &lt 1 RBKT   &kp N                    &kp M                       &kp COMMA                    &kp DOT              &kp FSLH              &kp RSHFT
                                                                         &mt LEFT_CONTROL GRAVE  &mt LEFT_ALT DELETE  &mt LEFT_GUI RS(RG(SPACE))  &lt 2 ENTER    &lt 3 SPACE  &mt RIGHT_GUI BACKSPACE  &mt RIGHT_ALT SINGLE_QUOTE  &mt RIGHT_CONTROL BACKSLASH
            >;

            label = "base";
        };

        functions-media {
            bindings = <
&trans         &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                          &kp F6            &kp F7         &kp F8         &kp F9                &kp F10                &kp C_VOLUME_UP
&kp C_BRI_UP   &kp F11       &kp F12       &kp F13       &kp F14       &kp F15                         &kp LC(UP_ARROW)  &kp C_PREV     &kp C_PLAY     &kp C_NEXT            &kp C_MUTE             &kp C_VOLUME_DOWN
&kp C_BRI_DEC  &kp EXCL      &kp AT        &kp HASH      &kp DOLLAR    &kp PRCNT                       &kp CARET         &kp AMPERSAND  &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp C_MUTE
&bt BT_CLR     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans    &trans  &kp GRAVE         &kp PIPE       &kp BACKSLASH  &kp SINGLE_QUOTE      &kp DOUBLE_QUOTES      &mt RIGHT_SHIFT CAPS
                                           &trans        &trans        &trans        &trans    &trans  &trans            &trans         &trans
            >;

            label = "functions-media";
        };

        arrows-windows {
            bindings = <
&trans  &trans                  &kp /*=⅓-LEFT*/ LC(LA(D))     &kp /*=⅓-CTR*/ LC(LA(F))      &kp /*=⅓-RIGHT*/ LC(LA(G))   &trans                                                      &trans  &kp HOME        &trans                &kp PAGE_UP    &trans  &trans
&trans  &trans                  &kp /*=TOP-LFT*/ LC(LA(U))    &kp /*=▲-TOP*/ LC(LA(UP))     &kp /*=TOP-RGT*/ LC(LA(I))   &trans                                                      &trans  &kp END         &kp /*=▲*/ UP         &kp PAGE_DOWN  &trans  &trans
&trans  &kp /*=⅔-LEFT*/ LC(LA(E)) &kp /*=LEFT*/ LC(LA(LEFT))  &kp /*=MAX*/ LC(LA(C))        &kp /*=RIGHT*/ LC(LA(RIGHT)) &kp /*=⅔-RGT*/ LC(LA(T))                                    &trans  &kp /*=◀*/ LEFT &kp /*=▼*/ DOWN_ARROW &kp /*=▶*/ RIGHT  &trans  &trans
&trans  &trans                  &kp /*=BOT-LFT*/ LC(LA(J))    &kp /*=▼-BOT*/ LC(LA(DOWN))   &kp /*=BOT-RGT*/ LC(LA(K))   &trans                     &trans                  &trans   &trans  &trans          &trans                &trans         &trans  &trans
                                                              &trans                        &trans                       &trans                     &trans                  &trans   &trans  &trans          &trans
            >;

            label = "arrows";
        };


        symbols-keypad {
            bindings = <
&trans           &trans       &trans             &trans            &trans             &trans                           &trans     &kp CLEAR     &kp SLASH     &kp ASTRK     &kp MINUS   &trans
&kp EXCLAMATION  &kp AT_SIGN  &kp TILDE          &kp LESS_THAN     &kp GREATER_THAN   &kp BACKSLASH                    &kp ASTRK  &kp N7        &kp N8        &kp N9        &kp PLUS    &trans
&kp HASH         &kp DOLLAR   &kp DOUBLE_QUOTES  &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp SLASH                        &kp SLASH  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS   &trans
&kp PERCENT      &kp CARET    &kp APOSTROPHE     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp QUESTION   &trans    &trans  &kp N0     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &trans
                                                 &trans            &trans             &trans         &trans    &trans  &trans     &kp N0        &kp PERIOD
            >;

            label = "symbols-keypad";
        };
    };
};
